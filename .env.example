# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<options>
MONGODB_DB_NAME=fixmate

# Generate with: openssl rand -base64 32  (must be at least 32 characters)
BETTER_AUTH_SECRET=<at-least-32-random-characters>
BETTER_AUTH_URL=http://localhost:5000

# Optional: server-side ImgBB API key for technician image uploads.
# Get a free key from https://imgbb.com/ and paste it only into .env (never commit it).
# IMGBB_API_KEY=<your-imgbb-api-key>
# Optional: override the ImgBB endpoint (used by local tests with a mock server).
# IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload

# Optional: Stripe payments (server-only — never expose via NEXT_PUBLIC_*, never commit real keys).
# All are optional for startup: payment endpoints answer 503 until configured,
# the rest of the API keeps working.
# Secret API key from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the webhook endpoint. From `stripe listen` (development)
# or the Dashboard webhook (production). See README → Stripe payments.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Lowercase ISO 4217 code for new Checkout Sessions. Safe default: usd.
# Set to bdt only when your Stripe account and payment method support BDT.
# STRIPE_CURRENCY=usd
# Local test override pointing at a mock of the Stripe API. Never set in production.
# STRIPE_API_BASE=http://127.0.0.1:4010
